<div class="fixed inset-0 w-screen h-screen bg-amber-50 flex items-center justify-center p-4 overflow-hidden">

  <div class="fixed -top-24 -right-24 w-96 h-96 rounded-full bg-orange-200 opacity-40 pointer-events-none blur-3xl"></div>
  <div class="fixed -bottom-20 -left-20 w-80 h-80 rounded-full bg-amber-200 opacity-30 pointer-events-none blur-3xl"></div>

  <div class="relative z-10 w-full max-w-md bg-white rounded-2xl border border-orange-100 shadow-xl shadow-orange-100/50">
    <div class="px-8 pt-8 pb-8">

      <div class="flex justify-center mb-5">
        <div class="w-14 h-14 rounded-full bg-orange-400 flex items-center justify-center shadow-lg shadow-orange-300/50">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </div>
      </div>

      <h2 class="text-center text-2xl font-bold text-stone-900 tracking-tight mb-1">
        Welcome back
      </h2>
      <p class="text-center text-sm text-stone-400 mb-7">
        Sign in to continue
      </p>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name),
                   html: { class: "flex flex-col gap-4" }) do |f| %>

        <div>
          <%= f.label :email, class: "block text-xs font-semibold text-orange-900 mb-1.5 tracking-wide" %>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none">
              <svg class="w-5 h-5 text-orange-300" fill="none" stroke="currentColor" stroke-width="1.8"
                   stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
            </span>
            <%= f.email_field :email,
                  autofocus: true,
                  autocomplete: "email",
                  placeholder: "you@example.com",
                  class: "w-full pl-12 pr-4 py-2.5 text-sm text-stone-800 bg-amber-50
                          border border-orange-100 rounded-xl outline-none
                          focus:border-orange-400 focus:ring-2 focus:ring-orange-400/20
                          placeholder:text-stone-300 transition" %>
          </div>
        </div>

        <div>
          <%= f.label :password, class: "block text-xs font-semibold text-orange-900 mb-1.5 tracking-wide" %>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none">
              <svg class="w-5 h-5 text-orange-300" fill="none" stroke="currentColor" stroke-width="1.8"
                   stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <rect x="3" y="11" width="18" height="11" rx="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
            </span>
            <%= f.password_field :password,
                  autocomplete: "current-password",
                  placeholder: "••••••••",
                  class: "w-full pl-12 pr-4 py-2.5 text-sm text-stone-800 bg-amber-50
                          border border-orange-100 rounded-xl outline-none
                          focus:border-orange-400 focus:ring-2 focus:ring-orange-400/20
                          placeholder:text-stone-300 transition" %>
          </div>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center justify-between">
            <label class="flex items-center gap-2 cursor-pointer text-xs text-stone-400">
              <%= f.check_box :remember_me,
                    class: "w-3.5 h-3.5 rounded accent-orange-400 cursor-pointer" %>
              Remember me
            </label>
            <% if devise_mapping.recoverable? %>
              <%= link_to "Forgot password?", new_password_path(resource_name),
                    class: "text-xs font-semibold text-orange-400 hover:text-orange-600 transition-colors" %>
            <% end %>
          </div>
        <% end %>

        <div class="flex justify-center">
          <%= f.submit "Sign in",
                class: "px-5 py-2.5 text-sm font-bold text-white bg-orange-400
                        rounded-xl cursor-pointer border-none
                        hover:bg-orange-500 active:scale-95
                        shadow-lg shadow-orange-300/40
                        transition-all duration-120" %>
        </div>
      <% end %>

      <!-- Divider -->
      <div class="relative flex items-center my-6">
        <div class="flex-grow border-t border-orange-100"></div>
        <span class="mx-3 text-xs text-stone-400 font-medium">OR</span>
        <div class="flex-grow border-t border-orange-100"></div>
      </div>

      <!-- Google Login Button -->
      <%= button_to user_google_oauth2_omniauth_authorize_path,
            method: :post,
            data: { turbo: false },
            class: "w-full flex items-center justify-center gap-3 px-5 py-2.5
                    text-sm font-semibold text-stone-700 bg-white
                    border border-orange-100 rounded-xl
                    hover:bg-amber-50 hover:border-orange-200
                    transition-all duration-200 shadow-sm" do %>

        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path fill="#4285F4"
                d="M21.35 12.27c0-.79-.07-1.55-.23-2.27H12v4.3h5.24a4.48 4.48 0 0 1-1.94 2.94v2.45h3.14c1.84-1.69 2.91-4.18 2.91-7.42z"/>
          <path fill="#34A853"
                d="M12 21.92c2.63 0 4.84-.87 6.45-2.36l-3.14-2.45c-.87.58-1.98.92-3.31.92-2.54 0-4.69-1.72-5.46-4.03H3.3v2.53A9.75 9.75 0 0 0 12 21.92z"/>
          <path fill="#FBBC05"
                d="M6.54 14a5.86 5.86 0 0 1 0-3.73V7.74H3.3a9.75 9.75 0 0 0 0 8.79L6.54 14z"/>
          <path fill="#EA4335"
                d="M12 6.24c1.43 0 2.72.49 3.73 1.45l2.8-2.8C16.84 3.25 14.63 2.08 12 2.08a9.75 9.75 0 0 0-8.7 5.66L6.54 10c.77-2.31 2.92-3.76 5.46-3.76z"/>
        </svg>

        <span>Continue with Google</span>
      <% end %>

      <!-- Optional: Sign up link -->
      <div class="mt-6 text-center">
        <p class="text-xs text-stone-400">
          Don't have an account?
          <%= link_to "Sign up", new_registration_path(resource_name),
                class: "font-semibold text-orange-400 hover:text-orange-600 transition-colors" %>
        </p>
      </div>

    </div>
  </div>
</div>

<style>
  html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    overflow: hidden;
  }
</style>