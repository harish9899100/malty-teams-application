<% if current_user.admin? %>
<div class= mx-8>

  <div class="min-h-screen bg-gray-50 px-8 py-6 lg:px-12 lg:py-10 max-w-6xl mx-auto">

    <div class="mb-8 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">All Teams</h1>
        <p class="mt-1 text-sm text-gray-400">Manage your teams and their members</p>
      </div>
      <span class="flex items-center gap-2 bg-indigo-50 border border-indigo-100 rounded-full px-4 py-1.5 text-sm font-medium text-indigo-600">
        <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
        admin
      </span>
    </div>

    <div class="flex flex-col gap-10">
      <% @teams.each do |team| %>

        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden mb-8 mt-6">

          <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
            <div>
              <h2 class="text-base font-semibold text-gray-900"><%= team.name %></h2>
              <p class="text-xs text-gray-400 mt-0.5">
                <%= team.users.count %> <%= team.users.count == 1 ? "member" : "members" %>
              </p>
            </div>

            <%= link_to invite_user_path(team_id: team.id),
                  class: "flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700
                          active:scale-95 text-white text-xs font-semibold
                          px-4 py-2 rounded-xl transition-all duration-150" do %>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <line x1="19" y1="8" x2="19" y2="14"/>
                <line x1="22" y1="11" x2="16" y2="11"/>
              </svg>
              invite user
            <% end %>
          </div>

          <div class="overflow-x-auto pt-4">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-gray-50 border-b border-gray-100">
                  <th class="text-left text-xs font-medium text-gray-400 px-6 py-3">Name</th>
                  <th class="text-left text-xs font-medium text-gray-400 px-6 py-3">Email</th>
                  <th class="text-left text-xs font-medium text-gray-400 px-6 py-3">Role</th>
                </tr>
              </thead>
              <tbody>
                <% if team.users.any? %>
                  <% team.users.each do |user| %>
                    <tr class="border-t border-gray-50 hover:bg-gray-50 transition-colors">

                      <td class="px-6 py-3">
                        <div class="flex items-center gap-3">
                          <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center
                                      justify-center text-indigo-600 text-xs font-semibold shrink-0">
                            <%#= user.name.first(1).upcase %>
                          </div>
                          <span class="text-gray-800"><%= user.name %></span>
                        </div>
                      </td>

                      <td class="px-6 py-3 text-gray-400 text-xs"><%= user.email %></td>

                      <td class="px-6 py-3">
                        <% role_classes = case user.role.to_s.downcase
                             when "admin"   then "bg-purple-100 text-purple-700"
                             when "manager" then "bg-blue-100 text-blue-700"
                             else                "bg-gray-100 text-gray-500"
                           end %>
                        <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium <%= role_classes %>">
                          <%= user.role.to_s.downcase %>
                        </span>
                      </td>

                    </tr>
                  <% end %>
                <% else %>
                  <tr>
                    <td colspan="3" class="px-6 py-8 text-center">
                      <div class="flex flex-col items-center gap-2">
                        <span class="text-xs text-gray-300">No members yet</span>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

        </div>
      <% end %>
    </div>
  </div>

<% else %>
  <div class="min-h-screen bg-gray-50 flex items-center justify-center p-6">
    <div class="w-full max-w-sm">
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">

        <div class="h-16 bg-indigo-600"></div>

        <div class="px-6 pb-6">
          <div class="-mt-7 mb-4 flex justify-center">
            <div class="w-14 h-14 rounded-2xl bg-white border-4 border-white shadow-md
                        flex items-center justify-center">
              <span class="text-xl font-bold text-indigo-600">
                <%= current_user.name.first(1).upcase %>
              </span>
            </div>
          </div>

          <h2 class="text-center text-lg font-semibold text-gray-900 mb-0.5">
            <%= current_user.name %>
          </h2>
          <p class="text-center text-xs text-gray-400 mb-5"><%= current_user.email %></p>

          <div class="flex flex-col gap-2.5">

            <div class="flex items-center justify-between bg-gray-50 rounded-xl px-4 py-3">
              <div class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     viewBox="0 0 24 24">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
                <span class="text-xs text-gray-400">Team</span>
              </div>
              <span class="text-sm font-medium text-gray-700">
                <%= current_user.team&.name || "no team assigned" %>
              </span>
            </div>

            <div class="flex items-center justify-between bg-gray-50 rounded-xl px-4 py-3">
              <div class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     viewBox="0 0 24 24">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                <span class="text-xs text-gray-400">Role</span>
              </div>
              <% role_classes = case current_user.role.to_s.downcase
                   when "admin"   then "bg-purple-100 text-purple-700"
                   when "manager" then "bg-blue-100 text-blue-700"
                   else                "bg-gray-100 text-gray-500"
                 end %>
              <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium <%= role_classes %>">
                <%= current_user.role.to_s.downcase %>
              </span>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<% end %>